# tubetell reads these from the environment, then the nearest .env walking up
# from the cwd, then $TUBETELL_ENV, then ~/.config/tubetell/.env. First
# definition wins; real environment variables beat every file. Copy this file
# to ~/.config/tubetell/.env to make tubetell work from any directory.
#
# Gemini (default provider): at least one of GEMINI_API_KEY or
# GOOGLE_CLOUD_PROJECT is required. --provider azure needs only the AZURE_*
# block at the end.

# Google AI Studio key (https://aistudio.google.com/apikey). Enables agentic
# processing via the Gemini Developer API — the default for YouTube and local
# files on gemini-3.8-flash/3.7-flash/3.6-flash/3.5-flash-lite when this is set. Vertex
# does not serve the Interactions API yet, so agentic needs this key even if
# you have a project. Optional if you only use static processing on Vertex.
# GEMINI_API_KEY=...

# Your GCP project (Vertex AI API must be enabled). Used by static processing
# (gs:// sources, --clip, --fps, --processing static, non-3.x models) and by
# --mode comments. Optional if you only run agentic on a GEMINI_API_KEY.
GOOGLE_CLOUD_PROJECT=my-project-id

# Optional; defaults to "global". Keep it there: on Vertex the Gemini 3.x models
# (including the default gemini-3.8-flash) are only served from global. Tubetell
# now coerces a regional value to global for those models and says so on stderr,
# but leaving it at global avoids the message.
GOOGLE_CLOUD_LOCATION=global

# Optional, Vertex only: path to a service-account key. If unset, tubetell uses
# your local Application Default Credentials (gcloud auth application-default
# login). A relative path is resolved against this .env file's directory.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Required only for --mode comments (YouTube Data API v3). Also lets tubetell
# look up a YouTube video's runtime, which the static path uses to size long
# videos.
# YOUTUBE_API_KEY=...

# --- --provider azure (Azure AI Foundry) -------------------------------------
# See docs/providers/azure.md. Auth is Entra ID: `az login` with the
# "Cognitive Services OpenAI User" role on the resource. No key needed.
# AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com

# Optional; these are the defaults. --model overrides the chat deployment.
# AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe-diarize
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-6.1-terra

# Optional fallback only, when Entra ID is not available. Keep a reference,
# not the key, and run under `op run --env-file=.env -- tubetell ...`.
# AZURE_OPENAI_API_KEY=op://<vault>/<item>/credential
