# tubetell reads these from the environment, then the nearest .env walking up
# from the cwd, then $TUBETELL_ENV, then ~/.config/tubetell/.env. First
# definition wins; real environment variables beat every file. Copy this file
# to ~/.config/tubetell/.env to make tubetell work from any directory.

# Google AI Studio key. Enables agentic processing (--processing auto|agentic)
# via the Gemini Developer API. Optional if you use Vertex (static processing).
# GEMINI_API_KEY=...

# Your GCP project (Vertex AI API must be enabled). Used by static processing
# and by --mode comments. Optional if you only run agentic on a GEMINI_API_KEY.
GOOGLE_CLOUD_PROJECT=my-project-id

# Optional; defaults to "global".
GOOGLE_CLOUD_LOCATION=global

# Optional: path to a service-account key. If unset, tubetell uses your
# local Application Default Credentials (gcloud auth application-default login).
# A relative path is resolved against this .env file's directory.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Required only for --mode comments (YouTube Data API v3).
# YOUTUBE_API_KEY=...
